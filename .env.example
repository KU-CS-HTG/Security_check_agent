# Copy to .env and chmod 600 .env. Never commit .env.

# --- PostgreSQL: three roles with separated privileges (see docs/security/db-roles.md) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432                       # host port; change if 5432 is taken (e.g. 5433)
POSTGRES_DB=opsgraph
POSTGRES_SUPERUSER=postgres_admin        # bootstrap only, not used by the app
POSTGRES_SUPERUSER_PASSWORD=change-me
DB_OWNER_USER=og_owner                   # migrations / DDL
DB_OWNER_PASSWORD=change-me
DB_COLLECTOR_USER=og_collector           # raw schema write only
DB_COLLECTOR_PASSWORD=change-me
DB_READER_USER=og_reader                 # read-only (query layer)
DB_READER_PASSWORD=change-me

# --- Neo4j Community (single user; no RBAC, see docs/security/db-roles.md) ---
NEO4J_URI=bolt://localhost:7687          # keep the port in sync with NEO4J_BOLT_PORT
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- Airflow (docker profile "airflow"; own DB role, no access to app data) ---
AIRFLOW_DB_USER=og_airflow
AIRFLOW_DB_PASSWORD=change-me
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=change-me

# --- Collection (external network needed only in this stage) ---
# Contact string put in the User-Agent of every outgoing request.
HTTP_CONTACT=your-email@example.com
NVD_API_KEY=

LOG_LEVEL=INFO
